# ======================================================
# AI News Studio — Environment Variables
# ======================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ──────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────
APP_NAME=AI News Studio
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-random-64-char-string
API_V1_PREFIX=/api/v1

# ──────────────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_news_studio
POSTGRES_USER=ainews
POSTGRES_PASSWORD=change-me-secure-password
# Note: DATABASE_URL is constructed programmatically in config.py
# from the individual POSTGRES_* variables above.

# ──────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ──────────────────────────────────────────────────────
# LLM Providers
# ──────────────────────────────────────────────────────
# Primary LLM provider: openai | anthropic | google
LLM_PRIMARY_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GOOGLE_AI_API_KEY=...
GOOGLE_AI_MODEL=gemini-2.0-flash

# ──────────────────────────────────────────────────────
# Image Generation (Replicate)
# ──────────────────────────────────────────────────────
REPLICATE_API_TOKEN=r8_...
IMAGE_MODEL=black-forest-labs/flux-1.1-pro
IMAGE_FALLBACK_MODEL=stability-ai/sdxl

# ──────────────────────────────────────────────────────
# Video Generation (Replicate)
# ──────────────────────────────────────────────────────
VIDEO_MODEL=wan-ai/wan2.2-t2v-14b
VIDEO_FALLBACK_MODEL=tencent/hunyuan-video

# ──────────────────────────────────────────────────────
# Voice / TTS (ElevenLabs & Edge-TTS)
# ──────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
EDGE_TTS_VOICE=en-US-AriaNeural

# ──────────────────────────────────────────────────────
# Video Format (YouTube Shorts)
# ──────────────────────────────────────────────────────
VIDEO_FORMAT=shorts
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# ──────────────────────────────────────────────────────
# YouTube OAuth2 & Publishing
# ──────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secrets.json
YOUTUBE_TOKEN_FILE=config/youtube_token.json
YOUTUBE_PLAYLIST_ID=
YOUTUBE_CATEGORY_ID=25
YOUTUBE_AUTO_PUBLISH=true
YOUTUBE_DEFAULT_PRIVACY=public

# ──────────────────────────────────────────────────────
# Facebook Page Publishing
# ──────────────────────────────────────────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_AUTO_PUBLISH=true

# ──────────────────────────────────────────────────────
# Whisper (Subtitles)
# ──────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ──────────────────────────────────────────────────────
# Scheduling & Daily Production Target
# ──────────────────────────────────────────────────────
DAILY_VIDEO_COUNT=3
STAGGER_UPLOADS_HOURS=1
PIPELINE_SCHEDULE_HOUR=8
PIPELINE_SCHEDULE_MINUTE=0
PIPELINE_SCHEDULE_HOURS=8,12,16,20
PIPELINE_TIMEZONE=UTC
NEWS_DISCOVERY_INTERVAL_MINUTES=60

# ──────────────────────────────────────────────────────
# Notifications
# ──────────────────────────────────────────────────────
# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ainewsstudio.com
NOTIFICATION_EMAIL=admin@example.com

# Slack
SLACK_WEBHOOK_URL=

# ──────────────────────────────────────────────────────
# File Storage
# ──────────────────────────────────────────────────────
MEDIA_ROOT=/app/media
GENERATED_DIR=/app/media/generated

# ──────────────────────────────────────────────────────
# Admin
# ──────────────────────────────────────────────────────
ADMIN_EMAIL=admin@ainewsstudio.com
ADMIN_PASSWORD=change-me

# ──────────────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
